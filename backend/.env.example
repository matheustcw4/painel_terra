# Copia pra .env (sem o .example). .env NUNCA é commitado.

ANTHROPIC_API_KEY=

# Gera um valor novo com: python -c "import secrets; print(secrets.token_hex(32))"
# Não reaproveita o exemplo abaixo em produção — é só ilustrativo.
JWT_SECRET=af1a9c1404e02cc857cb156e7a693f73c0efce8f41b8d22a010b64ca0641d2d6

# Precisa bater com onde o `npm run dev` do frontend sobe (padrão do Vite: 5173)
ORIGEM_FRONTEND=http://localhost:5173

# --- Zeus e Protector -------------------------------------------------------------
# Roda `claude mcp list` de dentro da pasta do projeto primeiro pra confirmar os NOMES
# reais visíveis aqui — vazamento de escopo pendente de resolver (LKS_PROTECTOR_DATABASE
# e relatorios-raizel aparecem mesmo de dentro da pasta Terra), então confere antes de
# assumir que são os nomes certos.
ZEUS_CONNECTION_STRING=postgresql://usuario:senha@host:5432/banco
PROTECTOR_CONNECTION_STRING=postgresql://usuario:senha@host:5432/banco

# --- Operacional (TESTE_INTEGRACAO: erp + clockify) --------------------------------
# `claude mcp get TESTE_INTEGRACAO` mostra comando e args reais. Se for o mesmo padrão
# do zeus/protector:
#   OPERACIONAL_COMMAND=npx
#   OPERACIONAL_ARGS=-y|@modelcontextprotocol/server-postgres|postgresql://usuario:senha@host:5432/banco
# (args separados por | , não por vírgula — connection string não deve ter | dentro)
OPERACIONAL_COMMAND=
OPERACIONAL_ARGS=

# --- Relatórios (já confirmado no claude mcp list) ----------------------------------
PYTHON312_PATH=C:\Program Files\Python312\python.exe
RELATORIOS_SERVER_PATH=C:\Workspace\Jarvs - Terra\mcp_relatorios\server.py

PAINEL_MODELO=claude-sonnet-5
